{
  "$schema":"http://json-schema.org/draft-07/schema#",
  "title":"Gastronomie-Briefing v3",
  "type":"object",
  "additionalProperties":false,
  "required":["id","name","kueche","ort","hauptaktion"],
  "properties":{
    "id":{"type":"string","pattern":"^[a-z0-9]+(?:-[a-z0-9]+)*$","minLength":2},
    "name":{"type":"string","minLength":1},
    "kueche":{"enum":["deutsch","bayerisch","italienisch","franzoesisch","spanisch","griechisch","tuerkisch","indisch","chinesisch","japanisch","vietnamesisch","international"]},
    "ort":{"type":"string","minLength":1},
    "hauptaktion":{"enum":["reservieren","bestellen","anrufen","informieren"]},
    "konzept":{"$ref":"#/definitions/text"},
    "usp":{"$ref":"#/definitions/text"},
    "zielgaeste":{"$ref":"#/definitions/text"},
    "preisklasse":{"$ref":"#/definitions/price"},
    "signaturgericht":{"$ref":"#/definitions/text"},
    "ambienteCharakter":{"$ref":"#/definitions/text"},
    "fotos":{"$ref":"#/definitions/photos"},
    "logoUrl":{"$ref":"#/definitions/url"},
    "primaerfarbe":{"$ref":"#/definitions/color"},
    "wunschschrift":{"$ref":"#/definitions/text"},
    "referenzUrls":{"$ref":"#/definitions/urls"},
    "goNos":{"$ref":"#/definitions/strings"},
    "oeffnungszeiten":{"$ref":"#/definitions/hours"},
    "telefon":{"$ref":"#/definitions/text"},
    "adresse":{"$ref":"#/definitions/text"},
    "video":{"$ref":"#/definitions/url"},
    "speisekarte":{"$ref":"#/definitions/menu"},
    "testimonials":{"$ref":"#/definitions/quotes"},
    "historie":{"$ref":"#/definitions/history"},
    "freigabe":{"$ref":"#/definitions/approval"}
  },
  "definitions":{
    "status":{"enum":["confirmed","draft","unknown"]},
    "approval":{"type":"object","required":["status","value"],"additionalProperties":false,"properties":{"status":{"$ref":"#/definitions/status"},"value":{"type":["boolean","null"]}}},
    "text":{"type":"object","required":["status","value"],"additionalProperties":false,"properties":{"status":{"$ref":"#/definitions/status"},"value":{"type":["string","null"]}}},
    "price":{"type":"object","required":["status","value"],"additionalProperties":false,"properties":{"status":{"$ref":"#/definitions/status"},"value":{"enum":["günstig","mittel","gehoben","fine-dining",null]}}},
    "url":{"type":"object","required":["status","value"],"additionalProperties":false,"properties":{"status":{"$ref":"#/definitions/status"},"value":{"anyOf":[{"type":"null"},{"type":"string","format":"uri","pattern":"^https://"}]}}},
    "color":{"type":"object","required":["status","value"],"additionalProperties":false,"properties":{"status":{"$ref":"#/definitions/status"},"value":{"type":["string","null"],"pattern":"^#[0-9a-fA-F]{6}$"}}},
    "photo":{"type":"object","required":["url","caption","confirmed"],"additionalProperties":false,"properties":{"url":{"type":"string","format":"uri","pattern":"^https://"},"caption":{"type":"string"},"confirmed":{"type":"boolean"}}},
    "photos":{"type":"object","required":["status","value"],"additionalProperties":false,"properties":{"status":{"$ref":"#/definitions/status"},"value":{"anyOf":[{"type":"null"},{"type":"array","items":{"$ref":"#/definitions/photo"}}]}}},
    "strings":{"type":"object","required":["status","value"],"additionalProperties":false,"properties":{"status":{"$ref":"#/definitions/status"},"value":{"anyOf":[{"type":"null"},{"type":"array","items":{"type":"string"}}]}}},
    "urls":{"type":"object","required":["status","value"],"additionalProperties":false,"properties":{"status":{"$ref":"#/definitions/status"},"value":{"anyOf":[{"type":"null"},{"type":"array","items":{"type":"string","format":"uri","pattern":"^https://"}}]}}},
    "hours":{"type":"object","required":["status","value"],"additionalProperties":false,"properties":{"status":{"$ref":"#/definitions/status"},"value":{"anyOf":[{"type":"null"},{"type":"object","additionalProperties":{"type":"string"}}]}}},
    "menuItem":{"type":"object","required":["name","price"],"additionalProperties":false,"properties":{"name":{"type":"string","minLength":1},"description":{"type":"string"},"price":{"type":"string"},"photoUrl":{"type":"string","format":"uri","pattern":"^https://"}}},
    "menu":{"type":"object","required":["status","value"],"additionalProperties":false,"properties":{"status":{"$ref":"#/definitions/status"},"value":{"anyOf":[{"type":"null"},{"type":"array","items":{"$ref":"#/definitions/menuItem"}}]}}},
    "quote":{"type":"object","required":["text","name"],"additionalProperties":false,"properties":{"text":{"type":"string"},"name":{"type":"string"}}},
    "quotes":{"type":"object","required":["status","value"],"additionalProperties":false,"properties":{"status":{"$ref":"#/definitions/status"},"value":{"anyOf":[{"type":"null"},{"type":"array","items":{"$ref":"#/definitions/quote"}}]}}},
    "event":{"type":"object","required":["year","text"],"additionalProperties":false,"properties":{"year":{"type":"string","pattern":"^[0-9]{4}$"},"text":{"type":"string"}}},
    "history":{"type":"object","required":["status","value"],"additionalProperties":false,"properties":{"status":{"$ref":"#/definitions/status"},"value":{"anyOf":[{"type":"null"},{"type":"array","items":{"$ref":"#/definitions/event"}}]}}}
  }
}
