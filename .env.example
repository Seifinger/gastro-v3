# Server ports; dashboard is deliberately loopback-only.
DASHBOARD_PORT=3000
WIRT_PORT=3001
HOST_DASHBOARD=127.0.0.1
HOST_WIRT=0.0.0.0

# Keep this long and private. Required as Bearer token on dashboard writes.
DASHBOARD_TOKEN=replace-with-a-long-random-token

# Required: signs wirt-portal session cookies. Keep long and private.
WIRT_SESSION_SECRET=replace-with-a-long-random-secret

# Optional: Web Push (default notification channel for the wirt-portal).
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:kontakt@example.invalid

# Optional: Telegram fallback notifications. Web Push remains the default.
TELEGRAM_BOT_TOKEN=

# Optional public base URL used in canonical and Open Graph URLs.
PUBLIC_BASE_URL=https://example.invalid

# Wirt-portal API origin the static customer sites POST reservations/orders
# to (renderer ctx.apiBase). Empty means relative paths (same origin only).
WIRT_API_BASE_URL=https://wirt.example.invalid

# v1 repository path for the non-destructive local migration script.
V1_DATA_PATH=../gastro-webagentur/data/betriebe.json
